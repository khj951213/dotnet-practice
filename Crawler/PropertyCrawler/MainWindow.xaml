<?xml version="1.0" encoding="utf-8" ?>

<Window
    x:Class="PropertyCrawler.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:PropertyCrawler"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="using:PropertyCrawler.Controls"
    xmlns:models="using:PropertyCrawler.Models"
    Title="PropertyCrawler"
    mc:Ignorable="d">

    <Window.SystemBackdrop>
        <MicaBackdrop/>
    </Window.SystemBackdrop>

    <ScrollViewer>

        <Grid Margin="32">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- HEADER -->
            <Grid Grid.Row="0">

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel
                        Grid.Column="0"
                        Spacing="4">

                        <TextBlock
                            Text="Properties"
                            FontSize="34"
                            FontWeight="SemiBold"/>

                        <TextBlock
                            x:Name="PropertyCountText"
                            Text="0 properties"
                            FontSize="15"
                            Opacity="0.6"/>

                    </StackPanel>

                    <Button
                        Grid.Column="1"
                        Content="Refresh"
                        Click="RefreshButton_Click"
                        VerticalAlignment="Center"/>

                </Grid>

                <AutoSuggestBox
                    x:Name="SearchBox"
                    Grid.Row="1"
                    Width="400"
                    HorizontalAlignment="Left"
                    Margin="0,20,0,0"
                    PlaceholderText="Search address or price..."
                    TextChanged="SearchBox_TextChanged"/>

            </Grid>

            <!-- FEATURED TITLE -->
            <TextBlock
                Grid.Row="1"
                Text="Featured Properties"
                FontSize="22"
                FontWeight="SemiBold"
                Margin="0,32,0,14"/>

            <!-- FEATURED CARDS -->
            <GridView
                Grid.Row="2"
                ItemsSource="{x:Bind FeaturedProperties}"
                SelectionMode="None">

                <GridView.ItemsPanel>

                    <ItemsPanelTemplate>
                        <ItemsWrapGrid
                            Orientation="Horizontal"
                            MaximumRowsOrColumns="4"/>
                    </ItemsPanelTemplate>

                </GridView.ItemsPanel>

                <GridView.ItemTemplate>

                    <DataTemplate>

                        <controls:PropertyCard
                            Property="{Binding}"/>

                    </DataTemplate>

                </GridView.ItemTemplate>

            </GridView>

            <!-- ALL PROPERTIES -->
            <StackPanel
                Grid.Row="3"
                Margin="0,32,0,40"
                Spacing="14">

                <TextBlock
                    Text="All Properties"
                    FontSize="22"
                    FontWeight="SemiBold"/>

                <Border
                    BorderThickness="1"
                    BorderBrush="#30000000"
                    CornerRadius="10">

                    <Grid>

                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- TABLE HEADER -->
                        <Border
                            Grid.Row="0"
                            Background="#10000000"
                            Padding="16">

                            <Grid>

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="3*"/>
                                    <ColumnDefinition Width="2*"/>
                                    <ColumnDefinition Width="80"/>
                                    <ColumnDefinition Width="80"/>
                                    <ColumnDefinition Width="80"/>
                                    <ColumnDefinition Width="120"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock
                                    Grid.Column="0"
                                    Text="Address"
                                    FontWeight="SemiBold"/>

                                <TextBlock
                                    Grid.Column="1"
                                    Text="Price"
                                    FontWeight="SemiBold"/>

                                <TextBlock
                                    Grid.Column="2"
                                    Text="Beds"
                                    FontWeight="SemiBold"/>

                                <TextBlock
                                    Grid.Column="3"
                                    Text="Baths"
                                    FontWeight="SemiBold"/>

                                <TextBlock
                                    Grid.Column="4"
                                    Text="Cars"
                                    FontWeight="SemiBold"/>

                                <TextBlock
                                    Grid.Column="5"
                                    Text="Land"
                                    FontWeight="SemiBold"/>

                            </Grid>

                        </Border>

                        <!-- TABLE ROWS -->
                        <ListView
                            Grid.Row="1"
                            ItemsSource="{x:Bind FilteredOtherProperties}"
                            SelectionMode="None">

                            <ListView.ItemContainerStyle>

                                <Style TargetType="ListViewItem">
                                    <Setter
                                        Property="HorizontalContentAlignment"
                                        Value="Stretch"/>

                                    <Setter
                                        Property="Padding"
                                        Value="0"/>
                                </Style>

                            </ListView.ItemContainerStyle>

                            <ListView.ItemTemplate>

                                <DataTemplate>

                                    <Border
                                        BorderThickness="0,0,0,1"
                                        BorderBrush="#20000000"
                                        Padding="16">

                                        <Grid>

                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="3*"/>
                                                <ColumnDefinition Width="2*"/>
                                                <ColumnDefinition Width="80"/>
                                                <ColumnDefinition Width="80"/>
                                                <ColumnDefinition Width="80"/>
                                                <ColumnDefinition Width="120"/>
                                            </Grid.ColumnDefinitions>

                                            <TextBlock
                                                Grid.Column="0"
                                                Text="{Binding Address}"
                                                VerticalAlignment="Center"
                                                TextTrimming="CharacterEllipsis"/>

                                            <TextBlock
                                                Grid.Column="1"
                                                Text="{Binding Price}"
                                                VerticalAlignment="Center"
                                                FontWeight="SemiBold"/>

                                            <TextBlock
                                                Grid.Column="2"
                                                Text="{Binding Bedrooms}"
                                                VerticalAlignment="Center"/>

                                            <TextBlock
                                                Grid.Column="3"
                                                Text="{Binding Bathrooms}"
                                                VerticalAlignment="Center"/>

                                            <TextBlock
                                                Grid.Column="4"
                                                Text="{Binding CarSpaces}"
                                                VerticalAlignment="Center"/>

                                            <TextBlock
                                                Grid.Column="5"
                                                Text="{Binding LandSize}"
                                                VerticalAlignment="Center"/>

                                        </Grid>

                                    </Border>

                                </DataTemplate>

                            </ListView.ItemTemplate>

                        </ListView>

                    </Grid>

                </Border>

            </StackPanel>

        </Grid>

    </ScrollViewer>

</Window>